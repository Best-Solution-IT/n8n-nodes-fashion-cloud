{
  "name": "n8n-nodes-fashion-cloud",
  "version": "0.1.0",
  "description": "n8n community node for the Fashion Cloud API v2 (brands, products, images, stock, prices, orders)",
  "license": "MIT",
  "homepage": "https://bitbucket.org/bastiansass/n8n-node-fashion-cloud",
  "keywords": [
    "n8n-community-node-package",
    "fashion",
    "fashioncloud",
    "fashion-cloud",
    "ecommerce",
    "products"
  ],
  "author": {
    "name": "Bastian Saß",
    "email": "npm@bestsolutionit.com"
  },
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/bastiansass/n8n-node-fashion-cloud.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "dev:docker": "n8n-node dev --external-n8n",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/FashionCloudApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FashionCloud/FashionCloud.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.50.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
