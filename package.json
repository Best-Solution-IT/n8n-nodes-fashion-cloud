{
  "name": "n8n-nodes-fashioncloud",
  "version": "0.1.0",
  "description": "n8n community node for the Fashion Cloud API (brands, products, images)",
  "keywords": [
    "n8n-community-node-package",
    "fashion",
    "fashioncloud",
    "ecommerce",
    "products"
  ],
  "license": "MIT",
  "homepage": "https://github.com/your-org/n8n-nodes-fashioncloud",
  "author": {
    "name": "Your Name",
    "email": "you@example.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/n8n-nodes-fashioncloud.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FashionCloudApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FashionCloud/FashionCloud.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^18.16.16",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "n8n-workflow": "^1.73.0",
    "typescript": "^5.1.6"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "overrides": {
    "form-data": "^4.0.4"
  }
}
